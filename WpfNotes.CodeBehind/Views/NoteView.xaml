<UserControl
    x:Class="WpfNotes.CodeBehind.Views.NoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel Margin="16">

        <!-- En bas : les boutons d'action -->
        <StackPanel
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Click="CancelButton_Click"
                Content="Annuler"
                Style="{StaticResource MaterialDesignFlatButton}" />
            <Button
                x:Name="DeleteButton"
                Margin="0,0,8,0"
                Click="DeleteButton_Click"
                Content="Supprimer"
                Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button Click="SaveButton_Click" Content="Enregistrer" />
        </StackPanel>

        <!-- En haut : la date d'enregistrement -->
        <TextBlock
            x:Name="DateText"
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            FontSize="12"
            Opacity="0.7" />

        <!-- Au centre : le texte de la note -->
        <TextBox
            x:Name="NoteText"
            VerticalContentAlignment="Top"
            materialDesign:HintAssist.Hint="Votre note"
            AcceptsReturn="True"
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
