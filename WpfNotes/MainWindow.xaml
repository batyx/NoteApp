<Window
    x:Class="WpfNotes.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="WpfNotes"
    Width="900"
    Height="600"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{materialDesign:MaterialDesignFont}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <!-- Le DialogHost entoure tout le contenu : c'est lui qui affiche les boîtes de dialogue -->
    <materialDesign:DialogHost Identifier="RootDialog">
        <DockPanel>

            <!-- Barre d'application : le titre -->
            <materialDesign:ColorZone
                Padding="16"
                DockPanel.Dock="Top"
                Mode="PrimaryMid">
                <TextBlock FontSize="20" Text="Mes notes" />
            </materialDesign:ColorZone>

            <Grid>
                <!-- L'écran courant : WPF choisit la vue grâce aux DataTemplate de App.xaml -->
                <ContentControl Content="{Binding CurrentViewModel}" />

                <!-- Zone de notification ; sa file de messages est donnée par App.xaml.cs -->
                <materialDesign:Snackbar x:Name="MainSnackbar" VerticalAlignment="Bottom" />
            </Grid>

        </DockPanel>
    </materialDesign:DialogHost>
</Window>
