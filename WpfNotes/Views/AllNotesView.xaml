<UserControl
    x:Class="WpfNotes.Views.AllNotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- La collection Notes du ViewModel, une carte par note -->
            <ItemsControl Margin="8" ItemsSource="{Binding Notes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- La carte est un bouton : sa commande est celle du ViewModel de la liste,
                             et son paramètre la note qu'elle affiche -->
                        <Button
                            Height="Auto"
                            Margin="8"
                            Padding="0"
                            Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <materialDesign:Card
                                Width="220"
                                Height="160"
                                Padding="16">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Bottom"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" />
                                    <TextBlock
                                        Text="{Binding Text}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </DockPanel>
                            </materialDesign:Card>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

        <!-- Visible seulement quand la collection est vide -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.7"
            Text="Aucune note. Cliquez sur + pour en créer une.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notes.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Bouton flottant « Nouvelle note » -->
        <Button
            Margin="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Command="{Binding NewNoteCommand}"
            Style="{StaticResource MaterialDesignFloatingActionButton}"
            ToolTip="Nouvelle note">
            <materialDesign:PackIcon
                Width="24"
                Height="24"
                Kind="Plus" />
        </Button>
    </Grid>
</UserControl>
